{
  "_note": "Complete normalised spec of the apps and tenants ApplicationSets as rendered by `helm template` with the default values of platform-gitops/bootstrap, except the template annotations other than PINNED_ANNOTATIONS. Edit only together with the ApplicationSet change it describes; regenerate with: python3 tests/test_generated_app_cascade_guards.py --print-golden",
  "sets": {
    "apps": {
      "metadata": {
        "name": "apps",
        "namespace": "argocd"
      },
      "spec": {
        "generators": [
          {
            "git": {
              "directories": [
                {
                  "path": "platform-gitops/services/*/*"
                }
              ],
              "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
              "requeueAfterSeconds": 30,
              "revision": "main"
            }
          }
        ],
        "goTemplate": true,
        "goTemplateOptions": [
          "missingkey=error"
        ],
        "syncPolicy": {
          "preserveResourcesOnDeletion": false
        },
        "template": {
          "metadata": {
            "annotations": {
              "argocd.argoproj.io/manifest-generate-paths": "/{{ .path.path }};/platform-gitops/helm-charts/base-service"
            },
            "labels": {
              "backstage.io/kubernetes-id": "{{ index .path.segments 3 }}",
              "env": "apps",
              "team": "{{ index .path.segments 2 }}"
            },
            "name": "{{ index .path.segments 2 }}-{{ index .path.segments 3 }}"
          },
          "spec": {
            "destination": {
              "namespace": "{{ index .path.segments 2 }}",
              "server": "https://kubernetes.default.svc"
            },
            "ignoreDifferences": [
              {
                "jqPathExpressions": [
                  ".data"
                ],
                "kind": "Secret",
                "name": "ghcr-credentials"
              },
              {
                "group": "external-secrets.io",
                "jqPathExpressions": [
                  ".metadata.annotations",
                  ".spec.target.deletionPolicy",
                  ".status"
                ],
                "kind": "ExternalSecret"
              }
            ],
            "project": "apps",
            "sources": [
              {
                "helm": {
                  "valueFiles": [
                    "$values/{{ .path.path }}/values.yaml"
                  ]
                },
                "path": "platform-gitops/helm-charts/base-service",
                "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
                "targetRevision": "main"
              },
              {
                "ref": "values",
                "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
                "targetRevision": "main"
              }
            ],
            "syncPolicy": {
              "automated": {
                "prune": true,
                "selfHeal": true
              },
              "retry": {
                "backoff": {
                  "duration": "5s",
                  "factor": 2,
                  "maxDuration": "3m"
                },
                "limit": 5,
                "refresh": true
              },
              "syncOptions": [
                "CreateNamespace=false",
                "ApplyOutOfSyncOnly=true",
                "ServerSideApply=true",
                "RespectIgnoreDifferences=true"
              ]
            }
          }
        }
      }
    },
    "tenants": {
      "metadata": {
        "name": "tenants",
        "namespace": "argocd"
      },
      "spec": {
        "generators": [
          {
            "git": {
              "directories": [
                {
                  "path": "platform-gitops/tenants/*"
                }
              ],
              "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
              "requeueAfterSeconds": 30,
              "revision": "main"
            }
          }
        ],
        "goTemplate": true,
        "goTemplateOptions": [
          "missingkey=error"
        ],
        "syncPolicy": {
          "preserveResourcesOnDeletion": false
        },
        "template": {
          "metadata": {
            "annotations": {
              "argocd.argoproj.io/manifest-generate-paths": "/{{ .path.path }};/platform-gitops/helm-charts/tenant"
            },
            "labels": {
              "env": "platform",
              "mctl.me/tenant": "{{ .path.basename }}"
            },
            "name": "tenant-{{ .path.basename }}"
          },
          "spec": {
            "destination": {
              "namespace": "{{ .path.basename }}",
              "server": "https://kubernetes.default.svc"
            },
            "ignoreDifferences": [
              {
                "group": "external-secrets.io",
                "jqPathExpressions": [
                  ".metadata.annotations",
                  ".spec.target.deletionPolicy",
                  ".status"
                ],
                "kind": "ExternalSecret"
              }
            ],
            "project": "platform",
            "sources": [
              {
                "helm": {
                  "valueFiles": [
                    "$values/{{ .path.path }}/values.yaml"
                  ]
                },
                "path": "platform-gitops/helm-charts/tenant",
                "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
                "targetRevision": "main"
              },
              {
                "ref": "values",
                "repoURL": "https://github.com/mctlhq/mctl-gitops.git",
                "targetRevision": "main"
              }
            ],
            "syncPolicy": {
              "automated": {
                "prune": true,
                "selfHeal": true
              },
              "retry": {
                "backoff": {
                  "duration": "10s",
                  "factor": 2,
                  "maxDuration": "2m"
                },
                "limit": 3,
                "refresh": true
              },
              "syncOptions": [
                "CreateNamespace=true",
                "ApplyOutOfSyncOnly=true",
                "ServerSideApply=true",
                "RespectIgnoreDifferences=true"
              ]
            }
          }
        }
      }
    }
  }
}
