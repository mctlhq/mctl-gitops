{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mctl.ai/schemas/agents/v1alpha2/execution-profile.schema.json",
  "title": "ExecutionProfile",
  "description": "agents.mctl.ai/v1alpha2 ExecutionProfile, per ADR 007 (mctlhq/mctl-agents docs/adr/007-agent-definition-execution-profile-contract.md). Reusable, independently versioned execution-shape constraints referenced by an AgentDefinition's executionProfileRef. Does not carry AgentDefinition identity/prompt/trigger data, and does not carry a global lifecycleState field -- registry publish/environment-release state lives in mctl-api, not here.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agents.mctl.ai/v1alpha2" },
    "kind": { "const": "ExecutionProfile" },
    "metadata": {
      "type": "object",
      "required": ["name", "owner"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "version",
        "modelPolicyRef",
        "skills",
        "tools",
        "policyRef",
        "permissions",
        "budgetUsd",
        "timeoutSeconds",
        "runtime",
        "approval",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "Semver-ish content version of this profile file. Bumped on any spec change. Independent of the mctl-api registry's own publish version number.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "modelPolicyRef": {
          "type": "object",
          "required": ["task", "compatibility"],
          "additionalProperties": false,
          "properties": {
            "task": { "type": "string", "minLength": 1 },
            "compatibility": { "type": "string", "minLength": 1 },
            "legacyEnvOverride": {
              "type": "string",
              "minLength": 1,
              "description": "Environment variable the agent's own driver module reads DIRECTLY as its highest-priority model override, bypassing config/model_policy.py (e.g. ISSUE_INVESTIGATOR_MODEL in run_issue_investigator.py). Optional -- most agents have none. Where one exists it OUTRANKS `task`, so a profile omitting it describes a model selection that can be overridden without the catalog saying so. mctl-agents' validate_manifest.py checks the declared name against a real os.getenv() call in the driver, in both directions."
            }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "SDK tool names, plus capability entries policy.yaml knownTools lists with category capability (e.g. human.request_input). Never authorization by itself -- see spec.permissions."
        },
        "policyRef": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "required": ["repository", "kubernetes", "network", "mutationScopes"],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "object",
              "required": ["read", "branchCreate", "commit", "pullRequestCreate", "merge"],
              "additionalProperties": false,
              "properties": {
                "read": { "type": "boolean" },
                "branchCreate": { "type": "boolean" },
                "commit": { "type": "boolean" },
                "pullRequestCreate": { "type": "boolean" },
                "merge": { "type": "boolean" }
              }
            },
            "kubernetes": { "enum": ["none", "read-only", "namespace-scoped"] },
            "network": { "enum": ["none", "approved-providers-only"] },
            "mutationScopes": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "budgetUsd": { "type": "number", "exclusiveMinimum": 0 },
        "timeoutSeconds": { "type": "integer", "exclusiveMinimum": 0 },
        "runtime": {
          "type": "object",
          "required": ["entrypoint", "optionsBuilder", "sandbox"],
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string", "minLength": 1 },
            "optionsBuilder": { "type": "string", "minLength": 1 },
            "sandbox": {
              "type": "object",
              "required": ["backend", "clusterWorkflowTemplate", "approved"],
              "additionalProperties": false,
              "properties": {
                "backend": { "type": "string", "minLength": 1 },
                "clusterWorkflowTemplate": { "type": "string", "minLength": 1 },
                "approved": { "type": "boolean" }
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "required": ["requiredBefore"],
          "additionalProperties": false,
          "properties": {
            "requiredBefore": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["required"],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "capabilityDiscovery": {
          "description": "Optional (mctl-agents#242 slice 4). Whether this profile PERMITS the issue-investigator's capability-discovery mode, and which providers discovery may reach. Absent == {enabled: false}. The catalog permits; the ISSUE_INVESTIGATOR_CAPABILITY_MODE env var still decides whether a deployment turns discovery on, and discovery runs only when both agree. mctl-agents' resolver (orchestrator/resolver.py _parse_capability_discovery) enforces the same rules and is authoritative; validate-agent-platform.py adds the cross-entry checks JSON Schema cannot express (unique aliases and (type, id) pairs, mctl-api keeps alias mctl).",
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "providers": {
              "description": "Ordered: alias assignment follows declaration order.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "id", "alias", "endpoint"],
                "additionalProperties": false,
                "properties": {
                  "type": { "enum": ["mcp-remote", "mcp-local", "sdk-builtin"] },
                  "id": { "type": "string", "pattern": "^[^/]+$" },
                  "alias": { "type": "string", "pattern": "^[^/]+$" },
                  "endpoint": {
                    "description": "A symbolic name resolved in mctl-agents code (mctl-api-mcp -> MCTL_MCP_URL), never a URL: a catalog edit must not be able to point the gateway, and the bearer token it sends, at an arbitrary host.",
                    "enum": ["mctl-api-mcp"]
                  }
                }
              }
            }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["providers"], "properties": { "providers": { "minItems": 1 } } }
        }
      }
    }
  }
}
