{
  "title": "ERPact workloads",
  "uid": "erpact-workloads",
  "tags": [
    "erpact",
    "tenant"
  ],
  "description": "Pods, restarts, CPU and memory of the erpact namespace. The datasource only ever returns erpact series (VMAuth adds namespace=erpact to every query), so no namespace filter is needed.",
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods by phase",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "sum by (phase) (kube_pod_status_phase == 1)",
          "legendFormat": "{{phase}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Container restarts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total[24h])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Pods not running",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "max by (pod, phase) (kube_pod_status_phase{phase!~\"Running|Succeeded\"} == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Containers waiting (reason)",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "max by (pod, container, reason) (kube_pod_container_status_waiting_reason == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU per pod",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\",metrics_path=\"/metrics/cadvisor\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory per pod (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{container!=\"\",metrics_path=\"/metrics/cadvisor\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Restarts per container (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "erpact-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "erpact-metrics"
          },
          "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total[1h])) > 0",
          "legendFormat": "{{pod}}/{{container}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
