{
  "title": "ERPact (tenant erpact)",
  "description": "Resources, health and storage of the ERPact copy running as tenant erpact.",
  "uid": "erpact-tenant",
  "tags": [
    "erpact",
    "tenant"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"erpact\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(kube_pod_info{namespace=\"erpact\"}, pod)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods running",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=\"erpact\",phase=\"Running\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods not ready",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(kube_pod_status_phase{namespace=\"erpact\",phase=\"Pending\"} == 1) or vector(0)) + (sum((kube_pod_status_ready{namespace=\"erpact\",condition=\"false\"} == 1) and on(namespace,pod) (kube_pod_status_phase{namespace=\"erpact\",phase=\"Running\"} == 1)) or vector(0))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"erpact\"}[24h])) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "CPU requests / quota",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource) (kube_resourcequota{namespace=\"erpact\",resource=\"requests.cpu\",type=\"used\"}) / sum by (resource) (kube_resourcequota{namespace=\"erpact\",resource=\"requests.cpu\",type=\"hard\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Memory requests / quota",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource) (kube_resourcequota{namespace=\"erpact\",resource=\"requests.memory\",type=\"used\"}) / sum by (resource) (kube_resourcequota{namespace=\"erpact\",resource=\"requests.memory\",type=\"hard\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Data volume used",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kubelet_volume_stats_used_bytes{namespace=\"erpact\"} / kubelet_volume_stats_capacity_bytes{namespace=\"erpact\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "description": "erpact-data (one RWO hcloud volume shared by MariaDB and both benches through subPaths).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU usage by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"erpact\",container!=\"\",metrics_path=\"/metrics/cadvisor\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU usage vs requests (namespace)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"erpact\",container!=\"\",metrics_path=\"/metrics/cadvisor\"}[5m]))",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"erpact\",resource=\"cpu\"})",
          "legendFormat": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "C",
          "expr": "kube_resourcequota{namespace=\"erpact\",resource=\"requests.cpu\",type=\"hard\"}",
          "legendFormat": "quota (requests)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU throttling by container",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"erpact\",container!=\"\",pod=~\"$pod\"}[5m])) / sum by (pod, container) (rate(container_cpu_cfs_periods_total{namespace=\"erpact\",container!=\"\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}/{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "description": "Share of CFS periods throttled. Sustained high values mean the CPU limit is too low for that container.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory working set by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"erpact\",container!=\"\",metrics_path=\"/metrics/cadvisor\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory vs requests and node headroom",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"erpact\",container!=\"\",metrics_path=\"/metrics/cadvisor\"})",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"erpact\",resource=\"memory\"})",
          "legendFormat": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "C",
          "expr": "kube_resourcequota{namespace=\"erpact\",resource=\"requests.memory\",type=\"hard\"}",
          "legendFormat": "quota (requests)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "description": "The cluster gets no new nodes: watch the gap between used and requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Memory use / limit by container",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, container) (container_memory_working_set_bytes{namespace=\"erpact\",container!=\"\",pod=~\"$pod\"}) / max by (pod, container) (kube_pod_container_resource_limits{namespace=\"erpact\",resource=\"memory\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}}/{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "description": "Close to 100% means an OOM kill is near.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Last termination reasons",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, container, reason) (kube_pod_container_status_last_terminated_reason{namespace=\"erpact\",reason!=\"Completed\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "Restarts, storage, network",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Container restarts (1h increase)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"erpact\",pod=~\"$pod\"}[1h])) > 0",
          "legendFormat": "{{pod}}/{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Data volume",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 8,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"erpact\"})",
          "legendFormat": "used {{persistentvolumeclaim}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=\"erpact\"})",
          "legendFormat": "capacity {{persistentvolumeclaim}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Network by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 16,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"erpact\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "rx {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "refId": "B",
          "expr": "-sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"erpact\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "tx {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Sites (blackbox probes)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Site availability",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"erpact-.*\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "description": "From VMProbes with job erpact-*; empty until the probes are added.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Site response time",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=~\"erpact-.*\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}
